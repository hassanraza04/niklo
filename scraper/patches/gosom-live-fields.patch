@@ -104,6 +129,15 @@ func (j *PlaceJob) Process(_ context.Context, resp *scrapemate.Response) (any, [
 
 	entry.ID = j.ParentID
 
+	if fields, ok := resp.Meta["live_place_fields"].(livePlaceFields); ok {
